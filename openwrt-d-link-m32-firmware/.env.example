# Copy to openwrt-d-link-m32-firmware/.env and populate your values (never commit .env!)

VERIFY_BUILD="true" # Default behaviour is true

# You can find the newest version on ducker hub: https://hub.docker.com/r/openwrt/imagebuilder/tags
# This specific script/build is meant to be used with a D-Link m32 A1 rev. (dlink_eagle-pro-ai-m32-a1)
# You can use the tag search feature by typing mediatek-mt7622. So an example could be mediatek-mt7622-25.12.6
# Or you can try and find it through the web GUI firmware interface: https://firmware-selector.openwrt.org
OPENWRT_VERSION="25.12.6"

# Root user on the sytem and for the web GUI. Busybox has no way to add user management in this build.
# So we change the password instead, to secure it more - and to have a way to actually use the web GUI.
MASTER_ROOT_PASS="CHANGE_ME"

# Leave the public key empty to not add a key, ssh is disabled by default no matter what.
# In other words, to activate it you have to go into the web GUI and enable it. Even if
# you use username/password combination to log into SSH.
# You can find it in: System -> Startup
# And then enable SSH by enabling "dropbear" (press enable and then start)
SSH_PUBLIC_KEY="ssh-ed25519 AAAA... your-key-comment"

# Trusted Wi-Fi (VLAN 20)
WIFI_TRUSTED_SSID="My WiFi Mesh"
WIFI_TRUSTED_PASS="CHANGE_ME"

# Guest Wi-Fi (VLAN 30)
WIFI_GUEST_SSID="My WiFi Guest"
WIFI_GUEST_PASS="CHANGE_ME"

# IoT Wi-Fi (VLAN 40)
WIFI_IOT_SSID="My WiFi IoT"
WIFI_IOT_PASS="CHANGE_ME"

# 5 GHz 802.11s Mesh Backhaul Password
MESH_BACKHAUL_ID="mesh-backhaul"
MESH_BACKHAUL_PASS="CHANGE_ME"
