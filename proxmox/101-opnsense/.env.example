# Copy this file to opnsense/.env and fill in real values (never commit .env!)

# Generate bcrypt/SHA-512 hash via: openssl passwd -6
OPNSENSE_DALLE_PASSWORD_HASH='$6$REPLACE_WITH_HASH'

# ISP PPPoE credentials
PPPOE_USERNAME='REPLACE_WITH_ISP_USERNAME'
PPPOE_PASSWORD='REPLACE_WITH_ISP_PASSWORD'

# Base64-encoded WebGUI TLS certificate and private key (single-line strings)
# Generate via: base64 -w0 cert.pem / base64 -w0 key.pem
OPNSENSE_WEBGUI_CERT_B64='REPLACE_WITH_BASE64_CERT'
OPNSENSE_WEBGUI_KEY_B64='REPLACE_WITH_BASE64_PRIVATE_KEY'
